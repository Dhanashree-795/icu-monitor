# ==============================================================================
# ICU Monitor Backend Configuration Template
# Copy this file to `backend/.env` and fill in your actual local configuration.
# DO NOT commit real secrets or `.env` to version control.
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=icu_monitor
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Authentication & Session Security
# Generate a strong random key (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
SESSION_EXPIRES_IN=8h

# Seed Demo Account Initial Passwords (Optional: used by db:seed script)
# Demo Accounts:
#   - Administrator: admin@admin.icu.in
#   - Doctor:        doctor@doctor.icu.in
#   - Nurse:         nurse@nurse.icu.in
#   - Housekeeping:  housekeeping@housekeeping.icu.in
DEMO_ADMIN_PASSWORD=AdminDemo2026!
DEMO_DOCTOR_PASSWORD=DoctorDemo2026!
DEMO_NURSE_PASSWORD=NurseDemo2026!
DEMO_HOUSEKEEPING_PASSWORD=HousekeepingDemo2026!

# Machine Learning Service (Experimental Length-of-Stay Prediction)
LOS_ML_API_URL=http://127.0.0.1:8000
